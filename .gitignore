# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/.impeccable/

# next.js
/.next/
/out/
# held by scripts/e2e-db.mjs while a suite runs in this checkout
/.e2e-run.lock

# production
/build
/public/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed: README tells you to copy it, and a
# fresh clone had none until this exception was added.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent harness installs (regenerate with: npx impeccable install)
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/record-flows
/.opencode/
/.pi/
/.codex/
/.agents/skills/impeccable/scripts/
/.impeccable/live/

# flow recordings: videos and the built gallery are generated
/recordings/output/
/recordings/site/
/recordings/logs/

# performance lab scratch space
/perf/.tmp/
/perf/dashboard/
