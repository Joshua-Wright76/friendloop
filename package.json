{
  "name": "friendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "check:flows": "node scripts/check-flows.mjs",
    "measure:navigation": "node --env-file=.env scripts/measure-loop-navigation.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "e2e": "node scripts/e2e-db.mjs run playwright test",
    "e2e:db": "node scripts/e2e-db.mjs start",
    "e2e:db:status": "node scripts/e2e-db.mjs status",
    "e2e:db:stop": "node scripts/e2e-db.mjs stop",
    "e2e:db:reset": "node scripts/e2e-db.mjs reset",
    "e2e:ui": "node scripts/e2e-db.mjs run playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run check:flows && npm run check:migrations",
    "check:migrations": "node scripts/check-migrations.mjs",
    "db:seed": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
