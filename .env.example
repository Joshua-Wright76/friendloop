# ── Database (Neon — free tier) ──────────────────────────────
# neon.tech → New Project → copy the pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Email (Resend — free tier: 3,000 emails/mo, 100/day) ─────
# resend.com → API Keys → Create API Key
RESEND_API_KEY="re_..."
# Verified sender address. On the free tier you can send from
# onboarding@resend.dev for testing, or verify your own domain.
EMAIL_FROM="Friendloop <onboarding@resend.dev>"

# ── Auth (magic links, hand-rolled on Postgres sessions) ─────
# No OAuth, no password, no signing secret: a session is a random 32-byte
# token in an httpOnly cookie, and only its SHA-256 hash is stored, so a
# leaked database never yields a usable session. Owners/admins sign in by
# email; contributors never sign in at all — their emailed reply link is
# the credential.

# ── App ──────────────────────────────────────────────────────
# Local dev URL; Vercel sets VERCEL_URL / NEXT_PUBLIC_APP_URL in prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: extra hostnames `next dev` may serve, comma separated. Needed only
# when developing through a local tunnel, whose hostname changes each run.
# ALLOWED_DEV_ORIGINS="abc-123.trycloudflare.com"

# ── Cron ─────────────────────────────────────────────────────
# Any random string; Vercel cron and the GitHub Actions schedule send
# it as a Bearer token so /api/cron/sweep can't be triggered by strangers.
# Generate with: openssl rand -hex 32
CRON_SECRET="..."

# The key that unlocks /dev/outbox outside local development. The preview
# screens are open at their /dev routes; the captured inbox holds live sign-in
# links, so it stays 404 until this is set and /dev/ui?key=... is opened once.
# Generate with: openssl rand -hex 32
# UI_PREVIEW_SECRET="..."

# ── Email transport ──────────────────────────────────────────
# "outbox" records every email in the database and never calls Resend.
# Unset → inbound: uses Resend when RESEND_API_KEY is present.
# EMAIL_TRANSPORT="outbox"

# Where the Resend SDK sends requests. Leave unset in production; the e2e suite
# points it at a local stub so the real "provider rejected it" path can be tested.
# RESEND_BASE_URL="http://127.0.0.1:3101"

# ── E2E ──────────────────────────────────────────────────────
# Throwaway Postgres for Playwright (a Neon branch or a local container).
# Tests truncate it between runs — never point this at dev data.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/friendloop_test"

# `E2E=1` enables the test seams: `x-e2e-now` moves the clock, and
# `x-e2e-email-transport` chooses the transport per request. It is refused when
# VERCEL_ENV=production, so inheriting it cannot hand callers the clock.
# E2E="1"

# ── Photos (Vercel Blob in production) ───────────────────────
# Local development writes to the gitignored public/uploads directory.
# Production requires a Blob store connected in Vercel → Storage → Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
