# How many emails may go out in any 24 hours. Default 100, Resend's free tier. Loop
# mail stops 20 short of it, keeping room for sign-in links, and the rest waits.
# EMAIL_DAILY_BUDGET="100"

# Where notes from the feedback button are emailed. Unset, they are only stored.
# FEEDBACK_NOTIFY_EMAIL="you@example.com"

# Where the Resend SDK sends requests. Leave unset in production; the e2e suite
# points it at a local stub so the real "provider rejected it" path can be tested.
# RESEND_BASE_URL="http://127.0.0.1:3101"

# ── Monitoring (Sentry — free tier) ──────────────────────────
# All optional: with no DSN nothing is initialized. In Vercel these come from the
# Sentry Marketplace integration (Vercel → Integrations → Sentry), which sets
# NEXT_PUBLIC_SENTRY_DSN, SENTRY_AUTH_TOKEN, SENTRY_ORG, and SENTRY_PROJECT (plus
# SENTRY_PUBLIC_KEY, SENTRY_VERCEL_LOG_DRAIN_URL, SENTRY_OTLP_TRACES_URL, which
# the app does not read). It does not set SENTRY_DSN; the server falls back to
# the public DSN. Locally: Project Settings → Client Keys (DSN).
# The browser's DSN, baked in at build time; also the server's unless SENTRY_DSN
# is set. Its ingest origin is added to the CSP's connect-src automatically.
# NEXT_PUBLIC_SENTRY_DSN="https://...@o0.ingest.us.sentry.io/0"
# Optional server/edge override; defaults to NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN="https://...@o0.ingest.us.sentry.io/0"
# Build-time only, for readable stack traces: uploads source maps when set and
# skips the upload (without failing the build) when not. Set it in Vercel, not here.
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="friendloop"

# ── E2E ──────────────────────────────────────────────────────
# Throwaway Postgres for Playwright (a Neon branch or a local container).
# Tests truncate it between runs — never point this at dev data.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/friendloop_test"

# `E2E=1` enables the test seams: `x-e2e-now` moves the clock, and
# `x-e2e-email-transport` chooses the transport per request. It is refused when
# VERCEL_ENV=production, so inheriting it cannot hand callers the clock.
# E2E="1"

# ── Photos (Vercel Blob in production) ───────────────────────
# Local development writes to the gitignored public/uploads directory.
# Production requires a Blob store connected in Vercel → Storage → Blob.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
